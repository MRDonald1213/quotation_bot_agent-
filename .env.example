# Copy to .env and adjust. Never commit .env.
# Local Ollama only — no remote LLM endpoints, no cloud fallback.
OLLAMA_BASE_URL=http://localhost:11434/v1
# Required: must match a name from `ollama list` (e.g. qwen3.5:latest). Not hard-coded in the app.
OLLAMA_MODEL=
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.75
WAIT_WINDOW_MINUTES=30
MAX_FILE_SIZE_MB=10
MAX_TEXT_CHARS=40000
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
WORKSPACE_DIR=./data/workspace
DATABASE_URL=sqlite:///./data/freight.db
# Optional Gmail integration. Keep credentials and tokens outside version control.
GOOGLE_OAUTH_CREDENTIALS_PATH=
GOOGLE_OAUTH_TOKEN_PATH=./data/google-oauth-token.json
GMAIL_SYNC_INTERVAL_SECONDS=30
GMAIL_BACKFILL_DAYS=30

# Local demonstration login (admin / 1234); not deployment-grade authentication.
DEMO_LOGIN_ENABLED=true
# Disable only in isolated test/demo profiles to prevent automatic mailbox polling.
GMAIL_BACKGROUND_ENABLED=true
